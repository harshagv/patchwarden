# Patchwarden settings. Copy to .env (or run `make env` to generate the secrets).
# .env is git-ignored. Never commit real values. Where to get each one: README "Secrets".

# development | test | production. Production refuses to start without the Required block.
APP_ENV=development

# Required
# Empty in development = SQLite at data/patchwarden.db.
# Production example: postgresql://user:password@localhost:5432/patchwarden
DATABASE_URL=
JWT_SECRET=
CREDENTIAL_KEY=

# docker compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=

# Public address used in shareable report links
PUBLIC_BASE_URL=http://localhost:8000
# Built-in demo sites (*.demo.patchwarden.test). On by default in development, refused in production.
DEMO_SITES=

# Patch agent backups (local disk). Empty = data/backups
BACKUP_DIR=

# Watchdog: run its scheduled jobs inside the app (on by default outside tests)
WATCHDOG_SCHEDULER=
# nvd (NVD API + php.net releases) or fixture (local JSON, the default in development)
CVE_FEED=
CVE_FIXTURE_PATH=
CVE_LOOKBACK_DAYS=7

# Optional: alerts. Without SMTP, alerts stay on the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
# Optional: CVE feed rate limit
NVD_API_KEY=
# Optional: off-site backups
S3_BACKUP_ENDPOINT=
S3_BACKUP_KEY=
S3_BACKUP_SECRET=
S3_BACKUP_BUCKET=
# Only when selling (Phase 6, not this build)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
