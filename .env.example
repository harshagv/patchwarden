# Patchwarden settings. Copy to .env (or run `make env` to generate the secrets).
# .env is git-ignored. Never commit real values. Where to get each one: README "Secrets".

# development | test | production. Production refuses to start without the Required block.
APP_ENV=development

# Required
# Empty in development = SQLite at data/patchwarden.db.
# Production example: postgresql://user:password@localhost:5432/patchwarden
DATABASE_URL=
JWT_SECRET=
# Comma-separate keys to rotate: the first encrypts, all decrypt (then run: python -m patchwarden rotate-credentials)
CREDENTIAL_KEY=

# docker compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=

# Public address used in shareable report links
PUBLIC_BASE_URL=http://localhost:8000
# Built-in demo sites (*.demo.patchwarden.test). On by default in development, refused in production.
DEMO_SITES=

# Patch agent backups (local disk). Empty = data/backups
BACKUP_DIR=

# Backups are encrypted at rest. Empty BACKUP_KEY = derived from CREDENTIAL_KEY. Comma-separate keys to rotate.
BACKUP_KEY=
BACKUP_RETENTION_DAYS=30

# Durable background jobs (patch, rollback, staging, promotion) and crash recovery
JOBS_POLLER=
JOBS_LEASE_SECONDS=60
JOBS_POLL_SECONDS=5

# Rate limits: free scans (domains per window), list scans, sign-ups and failed logins
SCAN_RATE_LIMIT=30
SCAN_RATE_LIMIT_USER=1000
SCAN_BULK_MAX=1000
SIGNUP_LIMIT=10
SCAN_RATE_WINDOW=60
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW=900
# Reverse proxies allowed to set X-Forwarded-For (comma-separated addresses). Empty = trust none.
TRUSTED_PROXIES=

# Watchdog: run its scheduled jobs inside the app (on by default outside tests)
WATCHDOG_SCHEDULER=
# nvd (NVD API + php.net releases) or fixture (local JSON, the default in development)
CVE_FEED=
CVE_FIXTURE_PATH=
CVE_LOOKBACK_DAYS=7

# Optional: alerts. Without SMTP, alerts stay on the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
# Optional: CVE feed rate limit
NVD_API_KEY=
# Watchdog: parallel version checks; EPSS score that makes an alert urgent; days a past-due site stays monitored
WATCHDOG_CONCURRENCY=20
EPSS_URGENT=0.1
DUNNING_GRACE_DAYS=14
# Billing export prices (no payment is taken; set your own) and migration quote rate
CURRENCY=USD
PRICE_PATCH=149
PRICE_WATCHDOG=29
PRICE_WP_GUARD=9
PRICE_VIRTUAL_PATCH=19
MIGRATION_HOURLY_RATE=95
# Signed attestations: base64url 32-byte Ed25519 seed (set in production); validity in days
ATTESTATION_KEY=
ATTESTATION_DAYS=30
# Migration tooling (Rector, PHPStan, php -l): off, docker (production), local (development only)
MIGRATION_TOOLS=off
SANDBOX_IMAGE=patchwarden/php-tools:1
SANDBOX_TIMEOUT=300
# Optional: off-site backups
S3_BACKUP_ENDPOINT=
S3_BACKUP_KEY=
S3_BACKUP_SECRET=
S3_BACKUP_BUCKET=
# Only when selling (Phase 6, not this build)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
